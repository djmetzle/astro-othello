---
import '../styles/sytle.css';
import Othello from '../components/Othello.vue'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>Othello - djmetzle.io</title>
		<!-- Site metadata (org, 2026-11-21): icons, the web app manifest, the canonical and the share tags. -->
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#333333" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:title" content="Othello - djmetzle.io" />
		<meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The djmetzle pixel mark and the name othello, in teal on white." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />
		<meta name="twitter:image:alt" content="The djmetzle pixel mark and the name othello, in teal on white." />
		<!-- Analytics (org, 2026-11-26): first-party Umami, from our own monitoring node, async. The inline
		     script is its data-before-send hook: the URL and referrer it records keep only the five utm_
		     parameters, and every other query parameter is dropped. -->
		<script is:inline>
		(function () {
		  var keep = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
		  var utmOnly = function (v) {
		    if (typeof v !== "string" || v === "") return v;
		    try {
		      var u = new URL(v, location.href), q = new URLSearchParams();
		      u.searchParams.forEach(function (value, name) { if (keep.indexOf(name) !== -1) q.append(name, value); });
		      u.search = q.toString();
		      return v.charAt(0) === "/" ? u.pathname + u.search + u.hash : u.toString();
		    } catch (e) { return v.split("?")[0]; }
		  };
		  window.umamiBeforeSend = function (type, payload) {
		    if (!payload) return payload;
		    payload.url = utmOnly(payload.url);
		    payload.referrer = utmOnly(payload.referrer);
		    return payload;
		  };
		})();
		</script>
		<script is:inline async src="https://collect.monitoring.djmetzle.io/script.js" data-website-id="cf283ecf-7b32-4977-b122-aa601124c87b" data-domains="othello.djmetzle.io" data-before-send="umamiBeforeSend"></script>
	</head>
	<body>
		<Othello client:only="vue" />
	</body>
</html>
